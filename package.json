{
  "name": "@local/dsh-github-workspaces",
  "version": "0.7.2",
  "private": true,
  "license": "MIT",
  "description": "把 GitHub 仓库当工作区：从 GitHub 克隆 / 拉取，工作区用仓库名，内置国内网络加速策略（直连 / SSH-over-443 / 镜像前缀 / 本地代理）。",
  "type": "module",
  "icon": "icon.svg",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "test",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.2.0-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
